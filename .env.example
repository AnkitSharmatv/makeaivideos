# Where the SQLite file, uploads, local media copies and the generated secret live. Default: ./data
DATA_DIR=

# Optional. 64 hex chars. If unset, a secret is generated on first run and kept in data/secret.key.
APP_SECRET=

# Let people other than the first (admin) account sign up. Default: false
ALLOW_SIGNUP=false

NEXT_PUBLIC_APP_NAME=MakeAiVideos
